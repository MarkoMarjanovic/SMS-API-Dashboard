# Copy to .env and fill in. Values here override what is saved on the Settings page.
PORT=4000
# Public URL Telesign can reach for delivery reports and inbound replies (e.g. https://sms.yourcompany.com)
PUBLIC_URL=http://localhost:4000
# Telesign credentials (Telesign Portal -> Account / API keys)
TELESIGN_CUSTOMER_ID=
TELESIGN_API_KEY=
# Optional: override API base URL (e.g. enterprise endpoint)
TELESIGN_BASE_URL=https://rest-api.telesign.com
# Secret used to sign session cookies. Generate a long random string.
SESSION_SECRET=change-me

# Hosted deployments
# Create this admin on first start (closes the public first-run setup page)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Load demo data when the database is empty (useful on hosts without a persistent disk)
SEED_DEMO=0
# Set to 1 when running behind a reverse proxy / PaaS load balancer
TRUST_PROXY=0
