{
  "name": "telesign-usage-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted dashboard for Telesign customers: spend, usage by product and country, campaigns, compliance and spending controls.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed:demo": "node server/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "express": "^5.3.0",
    "i18n-iso-countries": "^7.14.0",
    "libphonenumber-js": "^1.13.16",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "chart.js": "^4.6.1",
    "chartjs-chart-geo": "^4.3.6",
    "concurrently": "^10.0.7",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.8",
    "world-atlas": "^2.0.2"
  }
}
